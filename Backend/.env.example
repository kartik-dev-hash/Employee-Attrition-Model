# ==============================================================================
# Backend Configuration Example — Employee Attrition Model
# ==============================================================================

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# Timezone for Monthly Reminder Scheduling (Default: Asia/Kolkata)
SCHEDULE_TIMEZONE=Asia/Kolkata

# Set to true to disable automatic cron scheduling (useful in serverless or CI)
DISABLE_FEEDBACK_CRON=false

# Client Application Login URL (Included in employee reminder emails)
CLIENT_LOGIN_URL=http://localhost:5173/signIn

# ==============================================================================
# SMTP / Email Configuration (Nodemailer)
# ==============================================================================
# Set to 'true' only when you have valid SMTP credentials and want real emails sent.
# When 'false' or unset, the system runs safely in simulation/dev mode without errors.
SMTP_ENABLE_LIVE_SEND=false

# SMTP Server Host (e.g., smtp.gmail.com, smtp.mailgun.org, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL/TLS directly (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Account Username / Email (Do NOT commit real credentials to Git)
SMTP_USER=your_email@domain.com

# SMTP Account Password or App Password (e.g. Google App Password)
SMTP_PASS=your_app_password_here

# From address shown in outgoing emails
SMTP_FROM="HR Team - RetainPulse" <no-reply@retainpulse.local>
